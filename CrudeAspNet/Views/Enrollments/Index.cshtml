@model IEnumerable<CrudeAspNet.Models.Enrollment>
@{ ViewData["Title"] = "Enrollments"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-primary text-uppercase fw-semibold small mb-1">Registrations</p><h1 class="page-heading mb-1">Enrollments</h1><p class="text-secondary mb-0">Connect students to courses and school years.</p></div><a asp-action="Create" class="btn btn-primary">+ Add enrollment</a></div>
<section class="surface overflow-hidden"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Student</th><th>Student ID</th><th>Course</th><th>School-year code</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var enrollment in Model) {<tr><td class="fw-semibold">@enrollment.Student.StudentName</td><td>@enrollment.Student.StudentId</td><td>@enrollment.Course.CourseCode</td><td>@enrollment.SchoolYear.SchoolYearCode</td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@enrollment.Id" class="btn btn-sm btn-outline-secondary">Edit</a><form method="post" asp-action="Delete" asp-route-id="@enrollment.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Delete this enrollment?');">Delete</button></form></td></tr>}</tbody></table></div>@if (!Model.Any()) {<div class="text-center py-5"><h2 class="h4">No enrollments yet</h2><a asp-action="Create" class="btn btn-primary">Add enrollment</a></div>}</section>
