@model CrudeAspNet.Models.Student
@{ ViewData["Title"] = "Edit student"; }
<div class="row justify-content-center"><div class="col-lg-7">
    <a asp-action="Index" class="text-decoration-none text-secondary small">← Back to students</a>
    <div class="surface p-4 p-md-5 mt-3"><h1 class="page-heading h2">Edit student</h1><p class="text-secondary mb-4">Update this student’s details.</p>
        <form asp-action="Edit" method="post" novalidate>
            <input asp-for="Id" type="hidden" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3"><label asp-for="StudentName" class="form-label fw-medium">Student name</label><input asp-for="StudentName" class="form-control" /><span asp-validation-for="StudentName" class="text-danger small"></span></div>
            <div class="mb-3"><label asp-for="StudentId" class="form-label fw-medium">Student ID</label><input asp-for="StudentId" class="form-control" /><span asp-validation-for="StudentId" class="text-danger small"></span></div>
            <div class="mb-4"><label asp-for="Email" class="form-label fw-medium">Email <span class="text-secondary fw-normal">(optional)</span></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger small"></span></div>
            <div class="d-flex gap-2"><button class="btn btn-primary px-4" type="submit">Save changes</button><a asp-action="Index" class="btn btn-light border">Cancel</a></div>
        </form>
    </div>
</div></div>
