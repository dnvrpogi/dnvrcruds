@model CrudeAspNet.Models.SchoolYear
@{ ViewData["Title"] = "Add school year"; }
<div class="row justify-content-center"><div class="col-lg-7"><a asp-action="Index" class="text-decoration-none text-secondary small">← Back to school years</a><div class="surface p-4 p-md-5 mt-3"><h1 class="page-heading h2">Add school year</h1><form asp-action="Create" method="post" class="mt-4"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div><div class="mb-3"><label asp-for="SchoolYearCode" class="form-label fw-medium">School-year code</label><input asp-for="SchoolYearCode" class="form-control" placeholder="e.g. 2026-2027" /><span asp-validation-for="SchoolYearCode" class="text-danger small"></span></div><div class="mb-3"><label asp-for="Semester" class="form-label fw-medium">Semester</label><input asp-for="Semester" class="form-control" placeholder="e.g. First semester" /><span asp-validation-for="Semester" class="text-danger small"></span></div><div class="mb-4"><label asp-for="Status" class="form-label fw-medium">Status</label><select asp-for="Status" class="form-select"><option value="">Select status</option><option>Active</option><option>Closed</option><option>Upcoming</option></select><span asp-validation-for="Status" class="text-danger small"></span></div><button class="btn btn-primary px-4" type="submit">Save school year</button> <a asp-action="Index" class="btn btn-light border">Cancel</a></form></div></div></div>
