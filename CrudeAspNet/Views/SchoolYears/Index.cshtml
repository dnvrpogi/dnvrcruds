@model IEnumerable<CrudeAspNet.Models.SchoolYear>
@{ ViewData["Title"] = "School years"; }
<div class="d-flex justify-content-between align-items-center mb-4"><div><p class="text-primary text-uppercase fw-semibold small mb-1">Academic calendar</p><h1 class="page-heading mb-1">School years</h1><p class="text-secondary mb-0">Manage semesters and school-year status.</p></div><a asp-action="Create" class="btn btn-primary">+ Add school year</a></div>
<section class="surface overflow-hidden"><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>School-year code</th><th>Semester</th><th>Status</th><th class="text-end">Actions</th></tr></thead><tbody>@foreach (var year in Model) {<tr><td class="fw-semibold">@year.SchoolYearCode</td><td>@year.Semester</td><td>@year.Status</td><td class="text-end text-nowrap"><a asp-action="Edit" asp-route-id="@year.Id" class="btn btn-sm btn-outline-secondary">Edit</a><form method="post" asp-action="Delete" asp-route-id="@year.Id" class="d-inline"><button class="btn btn-sm btn-outline-danger" type="submit" onclick="return confirm('Delete this school year?');">Delete</button></form></td></tr>}</tbody></table></div>@if (!Model.Any()) {<div class="text-center py-5"><h2 class="h4">No school years yet</h2><a asp-action="Create" class="btn btn-primary">Add school year</a></div>}</section>
