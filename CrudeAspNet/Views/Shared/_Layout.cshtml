<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · StudentHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root { --ink: #18212f; --brand: #3e5fca; --muted: #64748b; --canvas: #f4f7fb; }
        body { background: var(--canvas); color: var(--ink); font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
        .topbar { background: #fff; border-bottom: 1px solid #e5eaf2; }
        .brand-mark { display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: 10px; background: var(--brand); color: #fff; font-weight: 800; }
        .page-heading { font-weight: 750; letter-spacing: -.03em; }
        .surface { background: #fff; border: 1px solid #e5eaf2; border-radius: 18px; box-shadow: 0 8px 28px rgba(15, 23, 42, .05); }
        .btn-primary { background: var(--brand); border-color: var(--brand); }
        .btn-primary:hover { background: #324faa; border-color: #324faa; }
        .table > :not(caption) > * > * { padding: 1rem; vertical-align: middle; }
        .table thead th { color: var(--muted); font-size: .76rem; letter-spacing: .06em; text-transform: uppercase; }
        .form-control { min-height: 48px; border-color: #dbe3ef; }
        .form-control:focus { border-color: #8da3e8; box-shadow: 0 0 0 .25rem rgba(62, 95, 202, .12); }
    </style>
</head>
<body>
    <header class="topbar">
        <div class="container py-3 d-flex align-items-center gap-2">
            <span class="brand-mark">S</span>
            <a asp-controller="Students" asp-action="Index" class="text-decoration-none text-dark fw-semibold">StudentHub</a>
        </div>
    </header>
    <main class="container py-5">
        @RenderBody()
    </main>
</body>
</html>
