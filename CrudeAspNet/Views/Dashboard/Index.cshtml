@model CrudeAspNet.Models.KierDashboardViewModel
@{ ViewData["Title"] = "KierCRUD dashboard"; }

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3 mb-4">
    <div>
        <p class="text-primary text-uppercase fw-semibold small mb-1">External data view</p>
        <h1 class="page-heading mb-1">KierCRUD dashboard</h1>
        <p class="text-secondary mb-0">Live data from the KierCRUD API.</p>
    </div>
    <a class="btn btn-primary" asp-action="Index">Refresh data</a>
</div>

@if (!Model.IsAvailable)
{
    <div class="alert alert-warning">@Model.ErrorMessage</div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-lg-3"><div class="surface p-4"><div class="text-secondary small">Students</div><div class="display-6 fw-semibold">@Model.Students.Count</div></div></div>
        <div class="col-6 col-lg-3"><div class="surface p-4"><div class="text-secondary small">Courses</div><div class="display-6 fw-semibold">@Model.Courses.Count</div></div></div>
        <div class="col-6 col-lg-3"><div class="surface p-4"><div class="text-secondary small">School years</div><div class="display-6 fw-semibold">@Model.SchoolYears.Count</div></div></div>
        <div class="col-6 col-lg-3"><div class="surface p-4"><div class="text-secondary small">Enrollments</div><div class="display-6 fw-semibold">@Model.Enrollments.Count</div></div></div>
    </div>

    <div class="row g-4">
        <div class="col-lg-6"><section class="surface overflow-hidden"><div class="p-4 border-bottom"><h2 class="h5 mb-0">Students</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>ID</th><th>Name</th><th>Status</th></tr></thead><tbody>@foreach (var student in Model.Students) {<tr><td>@student.Studid</td><td>@student.StudentName</td><td>@student.Status</td></tr>}</tbody></table></div></section></div>
        <div class="col-lg-6"><section class="surface overflow-hidden"><div class="p-4 border-bottom"><h2 class="h5 mb-0">Courses</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Code</th><th>Course</th></tr></thead><tbody>@foreach (var course in Model.Courses) {<tr><td>@course.Courscode</td><td>@course.CourseName</td></tr>}</tbody></table></div></section></div>
        <div class="col-lg-6"><section class="surface overflow-hidden"><div class="p-4 border-bottom"><h2 class="h5 mb-0">School years</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Code</th><th>School year</th></tr></thead><tbody>@foreach (var year in Model.SchoolYears) {<tr><td>@year.Sycode</td><td>@year.SchoolYearName</td></tr>}</tbody></table></div></section></div>
        <div class="col-lg-6"><section class="surface overflow-hidden"><div class="p-4 border-bottom"><h2 class="h5 mb-0">Enrollments</h2></div><div class="table-responsive"><table class="table table-hover mb-0"><thead class="table-light"><tr><th>Student</th><th>Course</th><th>School year</th></tr></thead><tbody>@foreach (var enrollment in Model.Enrollments) {<tr><td>@enrollment.StudentName</td><td>@enrollment.Courscode</td><td>@enrollment.SchoolYear</td></tr>}</tbody></table></div></section></div>
    </div>
}